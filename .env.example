# Set automatically by Next.js (dev/build/start) — do not set manually.
# Referenced in src/app/api/chat/route.ts to gate development-only error detail.
NODE_ENV=development

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3000

# App URL (OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (publishable key only — never put secret key here)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# GitHub OAuth (optional)
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OpenAI (support chat — server-side only in API routes)
OPENAI_API_KEY=
# Organization ID from platform.openai.com (optional; scopes billing/quota)
OPENAI_ORG_ID=
# Optional: override default model (gpt-4o-mini)
OPENAI_CHAT_MODEL=gpt-4o-mini

# Intercom (disabled by default — AI ChatWidget is the primary support channel)
NEXT_PUBLIC_ENABLE_INTERCOM=false
NEXT_PUBLIC_INTERCOM_APP_ID=

# Error tracking (Sentry) — optional. Leave both unset to disable entirely;
# src/instrumentation.ts and src/instrumentation-client.ts no-op without a DSN.
# NEXT_PUBLIC_SENTRY_DSN is used by both client and server unless SENTRY_DSN is also set.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Vercel CLI (local deploy only — never commit real values)
VERCEL_TOKEN=
VERCEL_ORG_ID=team_g1ftCcKDPvxTGOPWgfUqSoMe
VERCEL_PROJECT_ID=prj_tRPb5l7auEFV9iPLVRoFwzxwa1Rf
