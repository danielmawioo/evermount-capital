# Set automatically by Next.js (dev/build/start) — do not set manually.
# Referenced in src/app/api/chat/route.ts to gate development-only error detail.
NODE_ENV=development

# Set automatically by the Next.js runtime ("nodejs" or "edge") — do not set
# manually. Referenced in src/instrumentation.ts to skip Sentry init on the
# edge runtime, where it can't be lazy-loaded.
NEXT_RUNTIME=

# Set automatically by `yarn dev:mock` — do not set manually. When enabled,
# src/mocks/init.ts starts a Mock Service Worker so the app runs against
# src/mocks/handlers/* instead of a live backend. See README's "Run without
# a backend (mock mode)" section.
NEXT_PUBLIC_API_MOCKING=disabled

# Market Intelligence feature toggle (hold-deploy status)
# Set to "false" to hide Intelligence sidebar link and block /dashboard/intelligence.
# Omit or set to any other value to enable (default: enabled).
# Status: Legal freeze on provisional badge/Request Access strings.
NEXT_PUBLIC_MI_ENABLED=true

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3000

# App URL (OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Stripe (publishable key only — never put secret key here)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# GitHub OAuth (optional)
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OpenAI (support chat — server-side only in API routes)
OPENAI_API_KEY=
# Organization ID from platform.openai.com (optional; scopes billing/quota)
OPENAI_ORG_ID=
# Optional: override default model (gpt-4o-mini)
OPENAI_CHAT_MODEL=gpt-4o-mini

# Intercom (disabled by default — AI ChatWidget is the primary support channel)
NEXT_PUBLIC_ENABLE_INTERCOM=false
NEXT_PUBLIC_INTERCOM_APP_ID=

# Error tracking (Sentry) — optional. Leave both unset to disable entirely;
# src/instrumentation.ts and src/instrumentation-client.ts no-op without a DSN.
# NEXT_PUBLIC_SENTRY_DSN is used by both client and server unless SENTRY_DSN is also set.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional: live GEX engine for /research (falls back to fixture snapshot)
GEX_ENGINE_URL=

# Vercel CLI (local deploy only — never commit real values)
VERCEL_TOKEN=
VERCEL_ORG_ID=team_g1ftCcKDPvxTGOPWgfUqSoMe
VERCEL_PROJECT_ID=prj_tRPb5l7auEFV9iPLVRoFwzxwa1Rf
